# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fine-grained GitHub token: Issues read/write + Contents read on the target repo
GITHUB_TOKEN=
# Gemma 4 model id on the Gemini API (swap if your key exposes a different id)
GEMMA_MODEL=gemma-4-26b-a4b-it
PORT=8787

# Optional "Sign in with GitHub". Create an OAuth App at https://github.com/settings/developers
# with callback URL http://localhost:8787/api/auth/callback. When signed in, TraceLens uses
# the user's token instead of GITHUB_TOKEN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_URL=http://localhost:8787
