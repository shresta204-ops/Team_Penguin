# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fine-grained GitHub token: Issues read/write + Contents read on the target repo
GITHUB_TOKEN=
# Gemma 4 model id on the Gemini API (swap if your key exposes a different id)
GEMMA_MODEL=gemma-4-26b-a4b-it
PORT=8787

# Optional "Sign in with GitHub". Create an OAuth App at https://github.com/settings/developers
# with callback URL http://localhost:8787/api/auth/callback. When signed in, TraceLens uses
# the user's token instead of GITHUB_TOKEN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_URL=http://localhost:8787

# Guardrails (recommended for any public deployment)
# true = GitHub actions need "Sign in with GitHub"; GITHUB_TOKEN is never used for visitors.
REQUIRE_SIGN_IN=false
# Optional allowlist of GitHub logins that may sign in, comma-separated (empty = anyone).
ALLOWED_GITHUB_USERS=
# true when running behind a hosting proxy (Render, Railway, Fly) so rate limits see real client IPs.
TRUST_PROXY=false
